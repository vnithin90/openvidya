---
import InvestigateLayout from '../../layouts/InvestigateLayout.astro';
---

<InvestigateLayout title="Models you hold">
  <section class="inv-card">
    <p class="inv-kicker">Inventory</p>
    <h1 class="inv-title">Models you hold</h1>
    <p class="inv-lead">
      Models are earned by finishing investigations — not by reading a glossary first.
      They are reused later instead of being re-taught from zero.
    </p>
    <div id="model-list" class="model-list">
      <p class="note-soft">Checking what you have earned…</p>
    </div>
    <div class="inv-actions" style="margin-top:1.25rem">
      <a class="inv-btn primary" href="/learn/electricity/what-is-charge">Open: What is charge?</a>
      <a class="inv-btn" href="/">Home</a>
    </div>
  </section>
</InvestigateLayout>

<script>
  /* sessionStorage, and the key must match src/components/investigate/runtime.tsx.
     A lab machine is shared: what the last student earned is not this student's
     inventory. See the reasoning in runtime.tsx. */
  const KEY = 'openvidya.models';

  const KNOWN = {
    charge: ['Charge', 'Two kinds · transfer · like/unlike · net ≠ total', '/models/charge'],
    'coulomb-force': ['Coulomb force', 'Both charges · falls off fast with distance', null],
    'electric-field': ['Field', 'A judgment left open, with the criteria stated', null],
    polarisation: ['Polarisation', 'Charge shifts inside · zero leftover still feels a pull', null],
  };

  const el = document.getElementById('model-list');
  if (el) {
    let list = [];
    try {
      list = JSON.parse(sessionStorage.getItem(KEY) || '[]');
    } catch {
      list = [];
    }
    if (!list.length) {
      el.innerHTML =
        '<p class="note-soft">Nothing earned in this tab yet. Complete <a href="/learn/electricity/what-is-charge">What is charge?</a> to earn <strong>Charge</strong>. If you kept a copy of your record from another day, open it at the end of any investigation.</p>';
    } else {
      el.innerHTML = list
        .map((id) => {
          const m = KNOWN[id];
          if (!m) return `<div class="model-link"><strong>${id}</strong></div>`;
          const [name, gloss, href] = m;
          return href
            ? `<a class="model-link" href="${href}"><strong>${name}</strong><span>${gloss}</span></a>`
            : `<div class="model-link"><strong>${name}</strong><span>${gloss}</span></div>`;
        })
        .join('');
    }
  }
</script>

<style>
  .model-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .model-link {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.9rem 1rem;
    text-decoration: none;
    color: inherit;
    background: #fff;
  }
  .model-link:hover {
    border-color: var(--accent);
  }
  .model-link span {
    font-size: 0.88rem;
    color: var(--muted);
  }
</style>
