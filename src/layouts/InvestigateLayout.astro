---
interface Props {
  title: string;
  strand?: string;
}
const { title, strand } = Astro.props as Props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — OpenVidya</title>
    <meta
      name="description"
      content="Don't tell me what happens. Make me commit to what I think will happen."
    />
  </head>
  <body>
    <header class="inv-top">
      <a href="/" class="inv-brand">OpenVidya</a>
      {strand && <span class="inv-strand">{strand}</span>}
      <nav class="inv-nav">
        <a href="/">Home</a>
        <a href="/models">Models</a>
      </nav>
    </header>
    <main class="inv-main">
      <slot />
    </main>
    <footer class="inv-foot">
      <p class="inv-motto">
        Don’t tell me what happens. Make me commit to what I think will happen.
      </p>
      <p class="inv-motto-sub">Observe · Compare · Judge · Then model</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --ink: #111827;
    --muted: #6b7280;
    --line: #e5e7eb;
    --bg: #fafbfc;
    --card: #ffffff;
    --accent: #1d4ed8;
    --accent-soft: #eff6ff;
    --warn: #b45309;
    --warn-soft: #fffbeb;
    --ok-soft: #ecfdf5;
    --danger-soft: #fef2f2;
    --lock: #0f172a;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    color: var(--ink);
    background: var(--bg);
    font: 17px/1.55 ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
  }
  .inv-top {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid var(--line);
    background: #fff;
    flex-wrap: wrap;
  }
  .inv-brand {
    font-weight: 700;
    text-decoration: none;
    color: var(--ink);
    letter-spacing: -0.02em;
  }
  .inv-strand {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .inv-nav {
    margin-left: auto;
    display: flex;
    gap: 1rem;
  }
  .inv-nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9rem;
  }
  .inv-nav a:hover {
    color: var(--accent);
  }
  .inv-main {
    max-width: 720px;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 3rem;
  }
  .inv-foot {
    border-top: 1px solid var(--line);
    padding: 1.25rem;
    text-align: center;
    background: #fff;
  }
  .inv-motto {
    margin: 0;
    font-size: 0.92rem;
    color: var(--ink);
    font-weight: 500;
  }
  .inv-motto-sub {
    margin: 0.35rem 0 0;
    font-size: 0.8rem;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  /* Investigation shell */
  .ep-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
  }
  .ep-strip li {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    padding: 0.28rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: #fff;
  }
  .ep-strip li.done {
    border-color: #bbf7d0;
    background: var(--ok-soft);
    color: #166534;
  }
  .ep-strip li.now {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 700;
  }
  .inv-card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 1.35rem 1.4rem;
    margin-bottom: 1rem;
  }
  .inv-kicker {
    margin: 0 0 0.4rem;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--accent);
    font-weight: 600;
  }
  .inv-title {
    margin: 0 0 0.75rem;
    font-size: 1.55rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .inv-lead {
    margin: 0 0 1rem;
    color: #374151;
    font-size: 1.05rem;
  }
  .inv-proto {
    background: #f8fafc;
    border: 1px dashed #cbd5e1;
    border-radius: 10px;
    padding: 0.9rem 1rem;
    margin: 1rem 0;
    font-size: 0.95rem;
  }
  .inv-proto ol {
    margin: 0.4rem 0 0;
    padding-left: 1.2rem;
  }
  .inv-choices {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 1rem 0;
  }
  .inv-choice {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 0.75rem 0.9rem;
    cursor: pointer;
    background: #fff;
    transition: border-color 0.12s, background 0.12s;
  }
  .inv-choice:hover {
    border-color: #93c5fd;
  }
  .inv-choice.selected {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .inv-choice.locked {
    cursor: default;
    opacity: 0.95;
  }
  .inv-choice input {
    margin-top: 0.2rem;
  }
  .inv-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.1rem;
  }
  .inv-btn {
    border: 1px solid var(--line);
    background: #fff;
    border-radius: 8px;
    padding: 0.55rem 1rem;
    font-size: 0.92rem;
    cursor: pointer;
    color: #374151;
  }
  .inv-btn:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }
  .inv-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .inv-btn.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    font-weight: 600;
  }
  .inv-btn.primary:hover:not(:disabled) {
    background: #1e40af;
    color: #fff;
  }
  .inv-lock {
    margin-top: 1rem;
    background: var(--lock);
    color: #e2e8f0;
    border-radius: 10px;
    padding: 0.9rem 1rem;
  }
  .inv-lock h3 {
    margin: 0 0 0.35rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #94a3b8;
    font-weight: 600;
  }
  .inv-lock .val {
    font-size: 1.15rem;
    font-weight: 700;
    color: #fff;
  }
  .inv-lock p {
    margin: 0.45rem 0 0;
    font-size: 0.85rem;
    color: #94a3b8;
  }
  .inv-mismatch {
    margin-top: 1rem;
    border-radius: 12px;
    border: 1px solid #fde68a;
    background: var(--warn-soft);
    padding: 1rem 1.1rem;
  }
  .inv-mismatch.agree {
    border-color: #a7f3d0;
    background: var(--ok-soft);
  }
  .inv-mismatch .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  @media (max-width: 520px) {
    .inv-mismatch .pair {
      grid-template-columns: 1fr;
    }
  }
  .inv-mismatch .box {
    background: #fff;
    border-radius: 8px;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--line);
  }
  .inv-mismatch .box .lab {
    display: block;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin-bottom: 0.25rem;
  }
  .inv-mismatch .box .big {
    font-weight: 700;
    font-size: 1.05rem;
  }
  .inv-mismatch .need {
    margin: 0;
    font-weight: 600;
    color: #92400e;
  }
  .inv-mismatch.agree .need {
    color: #166534;
  }
  .conflict-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
    margin: 0.75rem 0;
  }
  .conflict-table th,
  .conflict-table td {
    text-align: left;
    padding: 0.55rem 0.4rem;
    border-bottom: 1px solid var(--line);
  }
  .conflict-table th {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
  }
  .model-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin: 1rem 0;
  }
  @media (max-width: 560px) {
    .model-cards {
      grid-template-columns: 1fr;
    }
  }
  .model-card {
    border: 2px solid var(--line);
    border-radius: 12px;
    padding: 0.9rem 1rem;
    background: #fff;
  }
  .model-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
  }
  .model-card p {
    margin: 0;
    font-size: 0.9rem;
    color: #374151;
  }
  .model-card.pick {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .scope-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin: 1rem 0;
  }
  @media (max-width: 560px) {
    .scope-grid {
      grid-template-columns: 1fr;
    }
  }
  .scope-box {
    border-radius: 10px;
    padding: 0.85rem 1rem;
    font-size: 0.9rem;
  }
  .scope-box.yes {
    background: var(--ok-soft);
    border: 1px solid #a7f3d0;
  }
  .scope-box.no {
    background: #f8fafc;
    border: 1px solid var(--line);
  }
  .scope-box h3 {
    margin: 0 0 0.45rem;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .scope-box ul {
    margin: 0;
    padding-left: 1.1rem;
  }
  .math-block {
    font-family: ui-monospace, 'Cascadia Code', monospace;
    background: #0f172a;
    color: #e2e8f0;
    border-radius: 10px;
    padding: 1rem 1.1rem;
    margin: 1rem 0;
    font-size: 1.05rem;
  }
  .math-block .sub {
    display: block;
    margin-top: 0.6rem;
    font-size: 0.85rem;
    color: #94a3b8;
  }
  .earned {
    border: 2px solid #86efac;
    background: var(--ok-soft);
    border-radius: 12px;
    padding: 1rem 1.1rem;
    margin-top: 1rem;
  }
  .human-turn {
    border-left: 4px solid #64748b;
    padding: 0.2rem 0 0.2rem 1rem;
    margin: 1rem 0;
  }
  .human-turn blockquote {
    margin: 0.75rem 0;
    padding: 0.75rem 0.9rem;
    background: #f1f5f9;
    border-radius: 8px;
    font-style: italic;
    color: #334155;
  }
  .survive-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
    margin: 0.75rem 0;
  }
  .survive-table td {
    padding: 0.4rem 0.35rem;
    border-bottom: 1px solid var(--line);
  }
  .vis-stage {
    height: 140px;
    border-radius: 12px;
    background: linear-gradient(180deg, #f8fafc, #eef2ff);
    border: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
    margin: 1rem 0;
    position: relative;
  }
  .balloon {
    width: 52px;
    height: 64px;
    border-radius: 50% 50% 50% 50% / 45% 45% 55% 55%;
    background: #3b82f6;
    position: relative;
    box-shadow: 0 8px 16px rgba(29, 78, 216, 0.2);
  }
  .balloon::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -18px;
    width: 1px;
    height: 18px;
    background: #94a3b8;
  }
  .balloon.b2 {
    background: #60a5fa;
  }
  .vis-caption {
    position: absolute;
    bottom: 8px;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .note-soft {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0.75rem 0 0;
  }
  .reset-row {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .reset-row button {
    font-size: 0.8rem;
    color: var(--muted);
    background: none;
    border: none;
    cursor: pointer;
    text-decoration: underline;
  }
</style>
